//robot.asl
/* Initial beliefs and rules */

// initially, I believe that there is some beer in the fridge
available(beer,fridge).
availableMed(med,medkit).
energy(100).
freeCharguer.
// my owner should not consume more than 10 beers a day :-)
limit(beer,5).

too_much(B) :-
   .date(YY,MM,DD) &
   .count(consumed(YY,MM,DD,_,_,_,B),QtdB) &
   limit(B,Limit) &
   QtdB > Limit.


/* Plans */

// Medicine consumption rules

+!medicineRoulette(X) : true & medicine(X,Y)
	<- .random([1,2,3,4,5], R);
	   if (R < 5) {
	   		.println("I am responsible for ", X);
	   	    !toOwnerMed(X,1);
	   } else {
	   		.println("Auxiliar is responsible for ", X);
			.send(auxiliar, tell, medicine(X,Y));
	   		.send(auxiliar, achieve, toOwnerMed(X,1));
	   }.

+!toOwnerMed(X,C) : true & startTime(H,M,S,MS) & .time(_,_,_,MS) & medicine(X,Y)
	<-  .wait(1);
		if(C mod (Y + (Y/2)) == 0){
			!spoiledMed(X);
			!toOwnerMed(X,C+1);
		} else{
			if((C + 10) mod Y == 0) {
				!medWalkOwner(X);
				!toOwnerMed(X,C+1);
			} else {
				!toOwnerMed(X,C+1);
			};
		}.
		
+!toOwnerMed(X,C) : true & startTime(H,M,S,MS)
	<- !toOwnerMed(X,C).

+!toOwnerMed(X,C) : true & not medicine(X,Y)
	<- .println("There´s no prescription for that medicine").
   
+!medWalkOwner(X) : availableMed(med,medkit) 
	<- !go_at(robot,medkit);
		open(medkit);
		-energy(N);
  	    +energy(N-1);
		take(med);
		-energy(N);
  	    +energy(N-1);
		close(medkit);
		-energy(N);
  	    +energy(N-1);
		!go_at(robot,owner);
		.print("here´s your ", X);
		!go_at(robot,fridge).

-!medWalkOwner(X) : true & not availableMed(med,medkit) 
	<- !go_at(robot,delivery);
   	   .send(proveedor, achieve, order(med,3));
	   .println("I´m asking for more medicines");
	   .wait(5000);
	   .println("I´m picking up the medicines");
	   !go_at(robot,medkit);
	   	open(medkit);
	   .println("Meds delivered");
	    close(medkit);
	   +availableMed(med,medkit);
	   !medWalkOwner(X).
	  
+!medWalkOwnerWithHelp(X) : true
	<- 	!go_at(robot,owner);
		.print("here´s your ", X);
		!go_at(robot,fridge).
		
+!spoiledMed(X) : true
	<- .println(X, " has spoiled!");
		!go_at(robot,medkit);
		open(medkit);
		.println("I´m removing ", X, " from the medkit");
		take(med);
		close(medkit);
		!go_at(robot,delivery);
		.println("Putting this spoiled medicine in the trash");
		.send(proveedor, achieve, order(med,1));
		.println("I´m asking for more medicines");
	    .wait(5000);
	    .println("I´m picking up the medicines");
	    !go_at(robot,medkit);
	   	open(medkit);
	    .println("Meds delivered");
	    close(medkit);
		!go_at(robot,fridge).

+medTaken : true
	<- !go_at(robot,medkit);
		open(medkit);
		!checkMed;
		close(medkit);
		!go_at(robot,fridge).

+!checkMed : true
	<- check(medkit);
	   .print("Medication has been taken").
-!checkMed : true
	<- .println("Medication has not been taken").

// Medicines modifiers

+!modifyMed(X,P) : true & medicine(X,Y)
	<- -medicine(X,Y);
	   +medicine(X,P).
+!addMed(X,P) : true
	<- +medicine(X,P).
+!removeMed(X) : true & medicine(X,Y)
	<- -medicine(X,Y).
	   
// Energy checking rules

+!energyLooker : energy(N) & N < 20
	<- !chargue;
		!energyLooker.
+!energyLooker : energy(N) & N > 19
	<- !energyLooker.
	
+!chargue : true & freeCharguer
	<- 	.send(auxiliar,tell,busyCharguer);
		!go_at(robot,charguer);
		.wait(5000);
		-energy(N);
		+energy(100);
		.send(auxiliar,tell,freeCharguer);
		!go_at(robot,fridge).

+!chargue : true & busyCharguer
	<- .println("Waiting for the charguer to be free");
		!chargue.
		
+!busyCharguer : true & freeCharguer
	<- -freeCharguer;
		+busyCharguer.
		
+!freeCharguer : true & busyCharguer
	<- -busyCharguer;
		+freeCharguer.

// Miscellaneous

+!go_at(robot,P) : at(robot,P) <- true.
+!go_at(robot,P) : not at(robot,P) & energy(N) & N > 0
  <- posibility(P,N);
  	 move_towards(P);
     -energy(N);
  	 +energy(N-1);
     !go_at(robot,P).
	 
-!go_at(robot,P) : true
	<-	!chargue;
		!go_at(robot,P).

+stock(med,0)
   :  availableMed(med,medkit)
   <- -availableMed(med,medkit).
+stock(med,N)
   :  N > 0 & not available(med,medkit)
   <- -+available(med,medkit). 

+delivered(med,_Qtd,_OrderId)[source(proveedor)]
  :  true
  <- +availableMed(med,medkit).
		
+?time(T) : true
  <-  time.check(T).

