// Rules for medication consumption in time
		
+!chooseMed(X): true & medicine(X,Y)
	<-  .random([1,2,3,4,5], R);
	   if (R == 5) {
	   		.println("I am responsible of ", X);
	   	    !byMyself(X,1);
	   } else {
			.send(robot, tell, medicine(X,Y));
	   		!robotDoes(X);
	   }.
	   
+!byMyself(X,C) : true & startTime(H,M,S,MS) & .time(_,_,_,MS) & medicine(X,Y)
	<-  .wait(1);
		.println(C);
		if(C mod (Y + (Y/2)) == 0){
			!go_at(owner,medkit);
			open(medkit);
			!spoiledMed(X);
			!byMyself(X,C+1);
		} else{
			if((C + 10) mod Y == 0) {
				!takeMed;
				!byMyself(X,C+1);
			} else {
				!byMyself(X,C+1);
			};
		}.
+!byMyself(X,C) : true & startTime(H,M,S,MS)
	<- !byMyself(X,C).

+!robotDoes(X) : true
	<-	.send(robot, achieve, medicineRoulette(X)).

+!takeMed : true & availableMed(med,medkit)
	<- !go_at(owner,medkit);
		open(medkit);
		take(med);
		close(medkit);
		.send(robot, tell, medTaken);
		!rest.
		
-!takeMed : true & not available(med,medkit)
	<- !go_at(owner,delivery);
   	   .send(supplier, achieve, order(med,3));
	   .println("I´m asking for more medicines");
	   .wait(5000);
	   .println("I´m picking up the medicines");
	   !go_at(owner,medkit);
	   +availableMed(med,medkit);
	   !takeMed.
	   
+!spoiledMed(X) : true & availableMed(med,medkit)
	<- .println(X, " has spoiled!");
		.println("I´m removing ", X, " from the medkit");
		take(med);
		close(medkit);
		!go_at(owner,delivery);
		.println("Putting this spoiled medicine in the trash");
		.send(supplier, achieve, order(med,1));
		.println("I´m asking for more medicines");
	    .wait(5000);
	    .println("I´m picking up the medicines");
	    !go_at(owner,medkit);
	   	open(medkit);
	    .println("Meds delivered");
	    close(medkit);
		!rest.
		
-!spoiledMed(X) : true & not availableMed(med,medkit)
	<- .println("Oh, there´s no medicines on the medkit, nothing can spoil").
		
// Medicines modifiers

+!modifyMed(X,P) : true & medicine(X,Y)
	<- .send(robot, tell, modifyMed(X,P));
	   -medicine(X,Y);
	   +medicine(X,P).
+!addMed(X,P) : true
	<- .send(robot, tell, addMed(X,P));
	   +medicine(X,P);
	   !chooseMed(X).
+!removeMed(X) : true & medicine(X,Y)
	<- 	.send(robot, tell, removeMed(X,P));
		-medicine(X,Y).

// Miscellaneous
		
+!go_at(owner,P) : at(owner,P) <- true.
+!go_at(owner,P) : not at(owner,P)
  <- move_towards(P);
     !go_at(owner,P).
	 
+!rest : true
	<- .random([1,2,3,4,5], R);
	   if (R == 1) {
	   		!go_at(owner,chair2);
	   } else {
			!go_at(owner,chair1);
	   }.
	 
+stock(med,0)
   :  availableMed(med,medkit)
   <- -availableMed(med,medkit).
+stock(med,N)
   :  N > 0 & not availableMed(med,medkit)
   <- -+availableMed(med,medkit).
	 
+msg(M)[source(Ag)] : true
   <- .print("Message from ",Ag,": ",M);
      -msg(M).
	  
+delivered(med,_Qtd,_OrderId)[source(supplier)]
  :  true
  <- +availableMed(med,medkit).

